{
  "name": "Loci",
  "extension": "../dist",
  "out": ".",
  "shots": [
    {
      "name": "welcome",
      "open": "extension:palace.html",
      "settle": 1200
    },
    {
      "name": "palace",
      "open": "extension:palace.html",
      "steps": [
        {
          "click": "#try"
        },
        {
          "wait": 2500
        }
      ]
    },
    {
      "name": "search",
      "open": "extension:palace.html",
      "steps": [
        {
          "click": "#try"
        },
        {
          "wait": 2000
        },
        {
          "click": "#search"
        },
        {
          "eval": "const s=document.querySelector('#search'); s.value='banana'; s.dispatchEvent(new Event('input',{bubbles:true}))"
        },
        {
          "wait": 1200
        }
      ]
    }
  ],
